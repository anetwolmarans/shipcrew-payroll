rules_version = '2';

// ============================================================================
// ShipCrew Payroll — Firebase Firestore Security Rules (Phase 4)
// ----------------------------------------------------------------------------
// PLAIN ENGLISH: these rules run on GOOGLE'S SERVERS and are the real
// security wall. Even if someone changes the app's code in their browser,
// these rules decide what they may actually read or write.
//
// Design principles:
//   1. DENY BY DEFAULT — anything not explicitly allowed is blocked.
//   2. ROLES LIVE IN THE users COLLECTION — a user's role is read from
//      users/{uid}, which only system administrators can change.
//   3. CREW SEE ONLY THEIR OWN DATA — enforced here, not just in the menu.
//   4. WRITE ACCESS opens phase by phase (least privilege). Phase 2 opened:
//      crew & banking (payroll/system admins), vessels, trips and
//      assignments (vessel managers/system admins), and clock events
//      (crew, for themselves, with validation). Phase 4 opens: break
//      records (crew, own), clock-event corrections (supervisors, closed
//      events only, originals preserved), catch records and quota
//      allocations (vessel managers/system admins, amendments with reason).
//   5. STATUTORY RULES (tax/SSC formulas) can NEVER be edited from the app —
//      not even by administrators. They change only via controlled,
//      versioned releases from the Firebase console / Admin SDK.
//   6. HISTORY IS SACRED: audit log, assignments, clock events, catch
//      records and quota allocations are append-only or strictly
//      constrained — nobody deletes history.
//
// Phase 6 (reports & exports) added NO new collections and NO new write
// access: every report is read-only and re-uses the per-collection read
// rules below, so a report can never show someone data they cannot read
// on the screens. v2.4.0 (Phase 5.5) added payslip_queries above.
//
// How to deploy: docs/01-firebase-setup.md, step 5 (or Guide 9 for the
// command line: firebase deploy --only firestore:rules).
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- helpers ----------------
    function signedIn() { return request.auth != null; }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasRole(role) { return signedIn() && userData().role == role; }
    function isSystemAdmin() { return hasRole('system_admin'); }
    function isPayrollAdmin() { return hasRole('payroll_admin'); }
    function isVesselManager() { return hasRole('vessel_manager'); }
    function isSupervisor() { return hasRole('supervisor'); }
    function isAuditor() { return hasRole('auditor'); }
    function isStaff() {
      return isSystemAdmin() || isPayrollAdmin() || isVesselManager() || isSupervisor() || isAuditor();
    }
    function isCrew() { return hasRole('crew'); }
    function unchanged(field) { return request.resource.data[field] == resource.data[field]; }

    // ---------------- users ----------------
    // Phase 2: system administrators create and manage logins in the app.
    // The creator's role is re-checked HERE on the server on every request.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if isSystemAdmin()
        && request.resource.data.email is string
        && request.resource.data.fullName is string
        && request.resource.data.status == 'active'
        && request.resource.data.role in ['system_admin', 'payroll_admin', 'vessel_manager', 'supervisor', 'crew', 'auditor'];
      allow update: if isSystemAdmin()
        && unchanged('createdAt') && unchanged('createdBy')
        && request.resource.data.role in ['system_admin', 'payroll_admin', 'vessel_manager', 'supervisor', 'crew', 'auditor'];
      allow delete: if false;   // accounts are disabled, never deleted
    }

    // ---------------- roles reference (read-only) ----------------
    match /roles/{roleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------------- companies ----------------
    match /companies/{companyId} {
      allow read: if signedIn();
      allow create, update: if isSystemAdmin();
      allow delete: if false;
    }

    // ---------------- crew & banking (confidential) ----------------
    // Phase 2: the crew register is managed in-app by the System and Payroll
    // Administrators. Created/updated records may not rewrite their own
    // creation stamps. Crew members still see ONLY their own record.
    match /crew/{crewId} {
      allow read: if signedIn() && (isStaff() || (isCrew() && resource.data.userId == request.auth.uid));
      allow create: if isSystemAdmin() || isPayrollAdmin();
      allow update: if (isSystemAdmin() || isPayrollAdmin())
        && unchanged('createdAt') && unchanged('createdBy');
      allow delete: if false;   // crew records are ended, never deleted
    }
    match /crew_banking/{crewId} {
      // Bank details are extra sensitive: payroll/system admins and the
      // owning crew member only. Nobody else — not even other staff.
      allow read: if signedIn() && (isSystemAdmin() || isPayrollAdmin()
        || (isCrew() && get(/databases/$(database)/documents/crew/$(crewId)).data.userId == request.auth.uid));
      allow create, update: if isSystemAdmin() || isPayrollAdmin();
      allow delete: if false;
    }

    // ---------------- vessels / trips / assignments ----------------
    // Phase 2: managed in-app by the Vessel Manager and System Administrator.
    match /vessels/{vesselId} {
      allow read: if signedIn();
      allow create, update: if isSystemAdmin() || isVesselManager();
      allow delete: if false;   // vessels are laid up (inactive), never deleted
    }
    match /trips/{tripId} {
      allow read: if signedIn();
      allow create, update: if isSystemAdmin() || isVesselManager();
      allow delete: if false;   // trips close; only truly empty planned trips may be removed
    }
    match /assignments/{assignmentId} {
      allow read: if signedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create, update: if isSystemAdmin() || isVesselManager();
      allow delete: if false;   // assignment history is permanent
    }

    // ---------------- clocking & work records ----------------
    // Phase 2: a crew member may create ONLY their own clock events, and may
    // close (clock out) their own still-open event. Nobody can change when a
    // clock-in happened, whose event it is, or delete an event.
    // Phase 4: supervisors may CORRECT closed events (reason mandatory,
    // originals preserved in the payload); the server trusts the payload's
    // correctionHistory because the audit log mirrors every correction.
    match /clock_events/{eventId} {
      allow read: if signedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isCrew()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.clockInAt is string
        && (request.resource.data.clockOutAt == null
            || (request.resource.data.clockOutAt is string
                && request.resource.data.clockOutAt > request.resource.data.clockInAt));
      allow update: if (isCrew()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && unchanged('clockInAt') && unchanged('employeeId') && unchanged('tripId')
          && !resource.data.clockOutAt)   // only while still open — a closed event is final
        || (isSupervisor() && resource.data.status == 'closed'
          && request.resource.data.status == 'closed'
          && request.resource.data.correctionHistory is list
          && request.resource.data.updatedBy is string);   // Phase 4 correction (originals kept in payload)
      allow delete: if false;
    }
    match /work_records/{recordId} {
      allow read: if signedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      allow write: if false;   // derived data (categories live on clock events)
    }
    match /break_records/{recordId} {
      // Phase 4: crew create/close their OWN breaks against their own open
      // clock event. Breaks are immutable once closed.
      allow read: if signedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isCrew()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.startedAt is string
        && request.resource.data.status == 'open';
      allow update: if isCrew()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && unchanged('employeeId') && unchanged('clockEventId') && unchanged('startedAt')
        && !resource.data.endedAt;   // only the open break may be closed
      allow delete: if false;
    }
    match /rest_records/{recordId} {
      allow read: if signedIn();
      allow write: if false;   // rest warnings are derived, stored on device only
    }

    // ---------------- catch & quota ----------------
    // Phase 4: the catch register and quota allocations are managed by the
    // Vessel Manager and System Administrator. Records carry their full
    // amendment history; nothing is ever deleted.
    match /catch_records/{recordId} {
      allow read: if signedIn();
      allow create: if (isSystemAdmin() || isVesselManager())
        && request.resource.data.weightKg is number
        && request.resource.data.weightKg > 0
        && request.resource.data.species is string;
      allow update: if (isSystemAdmin() || isVesselManager())
        && unchanged('createdAt') && unchanged('createdBy') && unchanged('tripId')
        && request.resource.data.amendments is list;   // amendments only, with reason
      allow delete: if false;   // catch history is permanent
    }
    match /quota_allocations/{recordId} {
      allow read: if signedIn();
      allow create: if (isSystemAdmin() || isVesselManager())
        && request.resource.data.lines is list
        && request.resource.data.method is string;
      allow update: if (isSystemAdmin() || isVesselManager())
        && unchanged('createdAt') && unchanged('createdBy') && unchanged('tripId');
      allow delete: if false;   // superseded allocations stay as history
    }

    // ---------------- contracts & remuneration ----------------
    match /contracts/{contractId} {
      // Phase 5: effective-dated, audited contract versions — staff read,
      // payroll/system admins write. Versions are never deleted. (Crew do
      // not read contracts directly; their payslips name the rate.)
      allow read: if signedIn() && (isSystemAdmin() || isPayrollAdmin() || isVesselManager() || isAuditor());
      allow create, update: if (isSystemAdmin() || isPayrollAdmin())
        && request.resource.data.crewId is string
        && request.resource.data.rateCents is int
        && request.resource.data.rateCents > 0
        && request.resource.data.effectiveFrom is string;
      allow delete: if false;   // history is sacred
    }
    match /remuneration_rules/{ruleId} {
      allow read: if signedIn() && (isSystemAdmin() || isPayrollAdmin() || isAuditor());
      allow write: if false;   // superseded by effective-dated contracts (Phase 5)
    }

    // ---------------- STATUTORY RULES (locked) ----------------
    // Tax, SSC and labour-law formulas are never editable from the app.
    // Updates arrive only as controlled, versioned releases verified against
    // official sources (see ARCHITECTURE.md — "Statutory rules governance").
    match /statutory_rules/{ruleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------------- payroll (Phase 5) ----------------
    match /payroll_periods/{periodId} {
      allow read: if isStaff();
      allow write: if false;   // periods are derived per trip — kept for future monthly runs
    }
    match /payroll_calculations/{calcId} {
      // Payroll runs (draft → locked). Staff read; only payroll/system admins
      // write. A locked run can never change its NUMBERS: the only transition
      // out of 'locked' is a v2.8.0 REOPEN back to 'draft' — the payslips
      // array must be unchanged (the issued payslips are revoked on the
      // payslips collection instead, never rewritten) and the reason is
      // recorded in approvalHistory + the audit log.
      allow read: if isStaff();
      allow create, update: if (isSystemAdmin() || isPayrollAdmin())
        && request.resource.data.status in ['draft', 'approved', 'locked']
        && request.resource.data.totals.grossCents is int
        && request.resource.data.totals.netCents is int
        && (!(resource.data.status == 'locked') || request.resource.data.status == 'locked'
             || request.resource.data.status == 'draft')
        && (resource.data.status != 'locked' || unchanged('payslips'));
      // Drafts may be replaced by a rebuild (one draft per trip) — but a
      // locked run is never deletable.
      allow delete: if (isSystemAdmin() || isPayrollAdmin()) && resource.data.status == 'draft';
    }
    match /payroll_approvals/{approvalId} {
      allow read: if isStaff();
      allow create: if isSystemAdmin() || isPayrollAdmin();   // approval history is append-only
      allow update, delete: if false;
    }
    match /payslips/{payslipId} {
      // Issued payslips: crew read ONLY their own (the payslip is stamped
      // with the crew member's userId when the run is approved).
      allow read: if signedIn() && (isPayrollAdmin() || isSystemAdmin() || isAuditor() || isVesselManager()
        || (isCrew() && resource.data.userId == request.auth.uid));
      // Payslips are CREATED only by approving a run, and NEVER change.
      allow create: if (isSystemAdmin() || isPayrollAdmin())
        && request.resource.data.status == 'issued'
        && request.resource.data.netCents is int;
      // v2.8.0: the ONLY update a payslip ever gets is the revoke flip when
      // its run is reopened. Every money field and the recipient are frozen
      // (unchanged) — a revoked payslip stays as the audit record, and the
      // corrected slip is a NEW document issued by re-approving the rebuilt run.
      allow update: if (isSystemAdmin() || isPayrollAdmin())
        && resource.data.status == 'issued'
        && request.resource.data.status == 'revoked'
        && unchanged('userId') && unchanged('crewId') && unchanged('tripId')
        && unchanged('grossCents') && unchanged('netCents') && unchanged('deductionCents')
        && unchanged('employerSscCents') && unchanged('lines');
      allow delete: if false;   // payslips are never deleted — revoked, not removed
    }
    match /deductions/{recordId} {
      // Phase 5: adjustment entries — visible corrections with reasons.
      allow read: if isPayrollAdmin() || isSystemAdmin() || isAuditor();
      allow create: if (isSystemAdmin() || isPayrollAdmin())
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 2;
      allow update: if (isSystemAdmin() || isPayrollAdmin()) && unchanged('reason') && unchanged('amountCents');
      allow delete: if false;   // adjustments are history — reverse, never delete
    }
    match /payslip_queries/{queryId} {
      // v2.4.0: payslip questions & disputes. Crew read ONLY their own
      // (the query is stamped with the crew member's userId when raised).
      allow read: if signedIn() && (isPayrollAdmin() || isSystemAdmin() || isAuditor()
        || (isCrew() && resource.data.userId == request.auth.uid));
      // A crew member opens a query against their OWN payslip only: the
      // stamped userId must be theirs and the status must start 'open'.
      allow create: if (isCrew() && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.message is string
          && request.resource.data.message.size() > 2)
        || (isSystemAdmin() || isPayrollAdmin());
      // Only payroll admins answer or close (open → answered/closed); the
      // crew member's original message can never be edited by anyone.
      allow update: if (isSystemAdmin() || isPayrollAdmin())
        && unchanged('message') && unchanged('crewId') && unchanged('payslipId')
        && (request.resource.data.status == 'answered' || request.resource.data.status == 'closed');
      allow delete: if false;   // queries are history — never deleted
    }
    match /allowances/{recordId} {
      allow read: if isPayrollAdmin() || isSystemAdmin() || isAuditor();
      allow create: if (isSystemAdmin() || isPayrollAdmin())
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0;
      allow update: if false;   // change an allowance by adding a correcting entry
      allow delete: if false;
    }

    // ---------------- audit log (append-only) ----------------
    match /audit_logs/{eventId} {
      allow create: if signedIn() && request.resource.data.actorId == request.auth.uid;
      allow read: if isSystemAdmin() || isAuditor();
      allow update, delete: if false;   // history is immutable
    }

    // ---------------- device registry ----------------
    match /devices/{deviceId} {
      allow read: if signedIn() && (isSystemAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if isSystemAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid
            && unchanged('userId') && unchanged('status'));
      allow delete: if isSystemAdmin();
    }

    // ---------------- sync idempotency ledger ----------------
    match /sync_transactions/{txId} {
      allow create: if signedIn();
      allow read: if isSystemAdmin() || isAuditor();
      allow update, delete: if false;
    }

    // ---------------- DEFAULT DENY ----------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
